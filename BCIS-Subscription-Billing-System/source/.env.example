# BCIS API + database configuration.
# Copy to `.env` and adjust for the local machine. `.env` is git-ignored;
# never commit real credentials.

# PostgreSQL connection string used by the API at runtime and by drizzle-kit.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bcis

# API bind address. Must be 0.0.0.0 (not 127.0.0.1) so the other two office
# PCs on the LAN can reach the API server.
API_HOST=0.0.0.0
API_PORT=3001

# Comma-separated list of allowed CORS origins. The Electron renderer is loaded
# from file:// in production and from http://127.0.0.1:4173 in development, so
# both are listed explicitly. `*` is never accepted.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Session lifetime in minutes. Sessions expire server-side (§4.4).
SESSION_TTL_MINUTES=120

# Failed logins before the account is temporarily locked, and lockout minutes.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Directory that stores payment proof screenshots and other attachments.
ATTACHMENT_DIR=./var/attachments

# Directory that stores database backups.
BACKUP_DIR=./var/backups
