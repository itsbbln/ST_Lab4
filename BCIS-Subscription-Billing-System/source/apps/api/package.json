{
  "name": "@bcis/api",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/money.test.ts tests/billing.test.ts tests/payments.test.ts",
    "test:integration": "cross-env BCIS_INTEGRATION=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bcis_test vitest run --no-file-parallelism tests/integration",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check-drift": "node ../../scripts/db-drift.mjs"
  },
  "dependencies": {
    "@bcis/shared": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
